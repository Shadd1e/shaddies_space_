# Supabase public project configuration (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY= # set to your Supabase publishable key

# Project idea explorer — server only; never prefix with NEXT_PUBLIC_
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Contact links
NEXT_PUBLIC_CALENDLY_URL=
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Brevo transactional email — server only
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Shaddies.Space
PROJECT_ENQUIRY_TO=support@shaddies.space

# Custom email verification — server only; generate a random secret of 32+ characters
EMAIL_VERIFICATION_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=https://shaddies.space
